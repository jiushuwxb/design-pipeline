# Claude API 配置（支持 Anthropic / DeepSeek / OpenAI 兼容 API）
ANTHROPIC_API_KEY=你的API-Key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=DeepSeek-V4-pro[1m]

# Stitch MCP 配置（L2 设计稿生成，需先在 Claude Code 中注册 MCP）
# 注册命令见 CLAUDE.md
STITCH_API_KEY=你的Stitch-API-Key
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# Vercel 部署配置（L4）
DEPLOY_PROVIDER=vercel
VERCEL_TOKEN=你的Vercel-Token
VERCEL_SCOPE=你的Vercel团队名

# 流水线模式配置
# mode: preview(快速预览) | development(可交付开发)
PIPELINE_MODE=preview
# preview 模式框架: react | vue | html
PREVIEW_FRAMEWORK=react
# development 模式配置
DEV_FRONTEND_FRAMEWORK=react
DEV_BACKEND_FRAMEWORK=express
DEV_BACKEND_LANGUAGE=typescript
DEV_ORM=prisma

# 代码规范（development 模式使用）
CODE_INDENT=spaces
CODE_INDENT_SIZE=2
CODE_QUOTES=single
CODE_SEMI=true
CODE_COMPONENT_NAMING=PascalCase
CODE_FILE_NAMING=PascalCase
CODE_CSS_APPROACH=tailwind
CODE_TYPESCRIPT=true
